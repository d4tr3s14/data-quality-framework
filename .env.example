# ============================================================================
# Configuración de ejemplo. Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas un `.env` con credenciales reales al repositorio.
# ============================================================================

# --- Backend de datos: 'duckdb' (demo, por defecto) o 'bigquery' (producción) ---
DB_BACKEND=duckdb

# --- DuckDB (demo) ---
DUCKDB_PATH=data/veridian_demo.duckdb

# --- BigQuery (solo si DB_BACKEND=bigquery) ---
# GCP_PROJECT_ID=mi-proyecto-gcp
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json

# --- Oracle (origen on-premise, opcional) ---
# ORACLE_HOST=oracle.example.com
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=ORCLPDB1
# ORACLE_USER=usuario
# ORACLE_PASSWORD=contraseña

# --- Integración con gestión de pruebas (desactivada por defecto) ---
TEST_MGMT_ENABLED=false
# JIRA_BASE_URL=https://tu-org.atlassian.net
# JIRA_USER_EMAIL=tu-email@example.com
# JIRA_API_TOKEN=tu-token-de-api
# TEST_EXECUTION_TICKET=PROJ-123
